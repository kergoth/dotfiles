#!/usr/bin/env bash
# Usage: install-codex --tag TAG --version VERSION --url URL --sha256 DIGEST
#
# Install a pinned Codex package release and remove any legacy package-manager
# installation. Idempotent: skips the download if the requested package is
# already installed under ~/.codex/packages/standalone.
#
# Options:
#     --tag TAG         Git tag for the release (e.g. rust-v0.122.0)
#     --version VERSION Normalized version string (e.g. 0.122.0)
#     --url URL         Download URL for the platform tarball
#     --sha256 DIGEST   Expected SHA-256 hex digest for the tarball
#     -h                Show this help message

set -euo pipefail

scriptname=${BASH_SOURCE[0]##*/}

usage() {
    sed -n '/^# Usage:/,/^# *-h /p' "${BASH_SOURCE[0]}" | sed 's/^# *//'
}

die() {
    printf '%s: %s\n' "$scriptname" "$*" >&2
    exit 1
}

replace_path_with_symlink() {
    local link_path=$1
    local target_path=$2
    local tmp_link=$3

    ln -s "$target_path" "$tmp_link"
    mv -f "$tmp_link" "$link_path"
}

version_from_binary() {
    "$1" --version 2>/dev/null \
        | sed -E 's/.*([0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z]+)*)/\1/' \
        | head -n1
}

release_dir_is_complete() {
    local release_dir=$1
    local expected_version=$2
    local expected_target=$3

    [ -d "$release_dir" ] || return 1
    [ "$(basename "$release_dir")" = "$expected_version-$expected_target" ] || return 1
    [ -f "$release_dir/codex-package.json" ] || return 1
    [ -x "$release_dir/bin/codex" ] || return 1
    [ -x "$release_dir/bin/codex-code-mode-host" ] || return 1
    [ -x "$release_dir/codex" ] || return 1
    [ -x "$release_dir/codex-path/rg" ] || return 1

    case "$expected_target" in
        *linux*)
            [ -x "$release_dir/codex-resources/bwrap" ] || return 1
            ;;
    esac

    [ "$(version_from_binary "$release_dir/bin/codex")" = "$expected_version" ]
}

tag=
version=
url=
sha256=

process_arguments() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --tag)
                shift
                tag=${1:-}
                ;;
            --version)
                shift
                version=${1:-}
                ;;
            --url)
                shift
                url=${1:-}
                ;;
            --sha256)
                shift
                sha256=${1:-}
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                usage >&2
                die "unknown argument: $1"
                ;;
        esac
        shift
    done
}

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

main() {
    process_arguments "$@"

    [ -n "$tag" ] || die "missing --tag"
    [ -n "$version" ] || die "missing --version"
    [ -n "$url" ] || die "missing --url"
    [ -n "$sha256" ] || die "missing --sha256"

    local bin_dir="$HOME/.local/bin"
    local local_bin="$bin_dir/codex"
    local host_bin="$bin_dir/codex-code-mode-host"
    local standalone_root="$HOME/.codex/packages/standalone"
    local releases_dir="$standalone_root/releases"
    local current_link="$standalone_root/current"
    local need_install=0
    local legacy_brew=0
    local legacy_npm=0
    local archive_name
    local archive
    local target
    local release_dir
    local stage_release
    local candidate_version
    local tmp_link

    mkdir -p "$bin_dir" "$releases_dir"

    archive_name=${url##*/}
    target=${archive_name#codex-package-}
    target=${target%.tar.gz}
    [ "$target" != "$archive_name" ] || die "expected codex package archive URL, got $archive_name"
    [ -n "$target" ] || die "could not determine Codex target from $archive_name"
    release_dir="$releases_dir/$version-$target"

    if ! release_dir_is_complete "$release_dir" "$version" "$target"; then
        need_install=1
    fi

    if [ "$need_install" -eq 0 ]; then
        if [ "$(readlink "$local_bin" 2>/dev/null || true)" != "$current_link/bin/codex" ]; then
            need_install=1
        fi
    fi

    if [ "$need_install" -eq 0 ]; then
        if [ "$(readlink "$host_bin" 2>/dev/null || true)" != "$current_link/bin/codex-code-mode-host" ]; then
            need_install=1
        fi
    fi

    if command -v brew >/dev/null 2>&1 && brew list --cask codex >/dev/null 2>&1; then
        legacy_brew=1
        need_install=1
    fi

    if command -v npm >/dev/null 2>&1 && npm list -g @openai/codex >/dev/null 2>&1; then
        legacy_npm=1
        need_install=1
    fi

    if [ "$need_install" -eq 0 ]; then
        printf 'Codex %s already installed\n' "$version"
        return 0
    fi

    printf 'Installing Codex %s from pinned release asset\n' "$version"
    archive="$tmpdir/$archive_name"
    fetch-verified -o "$archive" "$url" "$sha256"

    stage_release="$releases_dir/.staging.$version-$target.$$"
    rm -rf "$stage_release"
    mkdir -p "$stage_release"
    tar -xzf "$archive" -C "$stage_release"
    chmod 0755 \
        "$stage_release/bin/codex" \
        "$stage_release/bin/codex-code-mode-host" \
        "$stage_release/codex-path/rg"
    if [ -f "$stage_release/codex-resources/bwrap" ]; then
        chmod 0755 "$stage_release/codex-resources/bwrap"
    fi
    ln -sf "bin/codex" "$stage_release/codex"

    candidate_version=$(version_from_binary "$stage_release/bin/codex")
    [ "$candidate_version" = "$version" ] \
        || die "installed Codex version $candidate_version does not match expected $version"

    rm -rf "$release_dir"
    mv "$stage_release" "$release_dir"

    tmp_link="$standalone_root/.current.$$"
    replace_path_with_symlink "$current_link" "$release_dir" "$tmp_link"

    tmp_link="$bin_dir/.codex.$$"
    replace_path_with_symlink "$local_bin" "$current_link/bin/codex" "$tmp_link"

    tmp_link="$bin_dir/.codex-code-mode-host.$$"
    replace_path_with_symlink "$host_bin" "$current_link/bin/codex-code-mode-host" "$tmp_link"

    if [ "$legacy_brew" -eq 1 ]; then
        printf 'Removing legacy Homebrew Codex install\n'
        brew uninstall --cask codex
        hash -r 2>/dev/null || true
    fi

    if [ "$legacy_npm" -eq 1 ]; then
        printf 'Removing legacy npm Codex install\n'
        npm uninstall -g @openai/codex || true
        hash -r 2>/dev/null || true
    fi

    "$local_bin" --version >/dev/null
    [ -x "$host_bin" ] || die "Codex code-mode host is unavailable after install"
}

main "$@"
