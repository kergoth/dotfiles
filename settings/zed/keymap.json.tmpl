[
  // Exit vim insert mode with 'jk'.
  {
    "context": "Editor && !VimWaiting && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore"
    }
  },
  // Fold all with zM
  {
    "context": "vim_mode == normal",
    "bindings": {
      "z M": ["workspace::SendKeystrokes", "cmd-a z c escape g g"]
    }
  },
  // Unfold all with zR
  {
    "context": "vim_mode == normal",
    "bindings": {
      "z R": ["workspace::SendKeystrokes", "cmd-a z o escape g g"]
    }
  },
  // Re-wrap with alt+q
  {
    "context": "Editor",
    "use_key_equivalents": true,
    "bindings": {
      "alt-q": "editor::Rewrap",
    }
  },
  // Better integration with TUIs like pi and claude code
  {
    "context": "Terminal",
    "bindings": {
      "shift-enter": ["terminal::SendText", "\u001b[13;2u"],
      "ctrl--": ["terminal::SendText", "\u001b[45;5u"],
      "ctrl-alt-]": ["terminal::SendText", "\u001b[93;7u"]
    }
  }
]
