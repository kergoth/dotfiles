{
  "theme": "catppuccin-latte/dracula",
  "packages": [
{{- if .work }}
    "npm:pi-cursor-sdk",
{{- end }}
    "npm:@sherif-fanous/pi-catppuccin",
    "npm:@sherif-fanous/pi-dracula",
    "git:github.com/kergoth/pi-claude-bridge@context-cap",
    "npm:pi-web-access",
    {
      "skills": [
        "-skills/council-mode/SKILL.md"
      ],
      "source": "npm:pi-subagents"
    }
  ],
  "hideThinkingBlock": true,
  "quietStartup": true,
  "showHardwareCursor": true,
  "defaultThinkingLevel": "medium",
  "defaultTools": ["+codemode"],
  "tuiMode": "fullscreen",
  "steeringMode": "all",
  "followUpMode": "all",
{{- $allModels := list
    "alias/coding-budget"
    "alias/coding"
    "alias/coding-max"
    "alias/**"
    "claude-bridge/claude-sonnet-5-5"
    "openai-codex/gpt-5.6-terra"
    "opencode-go/kimi-k2.7-code"
    "opencode-go/deepseek-v4.1-flash"
    "cursor/grok-4.7@256k"
    "claude-bridge/claude-opus-5-5"
    "opencode-go/glm-5.3"
    "opencode-go/deepseek-v4-pro"
    "cursor/composer-2-5"
    "cursor/auto-smart"
    "local-coder/**"
    "local-reason/**"
    "mtplx/**"
    "claude-bridge/claude-sonnet-4-6"
    "claude-bridge/claude-opus-4-6"
    "claude-bridge/claude-sonnet-5"
    "claude-bridge/claude-opus-5"
    "openai-codex/gpt-5.6-sol"
    "opencode-go/kimi-k3"
    "local-assistant/**"
    "openai-codex/gpt-5.6-luna"
    "opencode-go/gpt-5.6-luna"
    "opencode-go/qwen3.8-flash"
    "local-reason-long/**"
    "local-quality/**"
    "claude-bridge/claude-sonnet-*"
    "claude-bridge/claude-opus-*"
    "openai-codex/**"
-}}
{{- $exclude := list -}}
{{- if not .personal -}}
{{-   $exclude = concat $exclude (list
        "mtplx/**"
      )
-}}
{{- end -}}
{{- if .work -}}
{{-   $exclude = concat $exclude (list
        "opencode-go/kimi-k3"
        "opencode-go/glm-5.3"
        "opencode-go/deepseek-v4-pro"
        "opencode-go/kimi-k2.7-code"
        "opencode-go/deepseek-v4.1-flash"
        "opencode-go/gpt-5.6-luna"
        "opencode-go/qwen3.8-flash"
      )
-}}
{{- end -}}
{{- if not .work -}}
{{-   $exclude = concat $exclude (list
        "cursor/composer-2-5"
        "cursor/auto-smart"
        "cursor/grok-4.7@256k"
      )
-}}
{{- end -}}
{{- if not (stat (joinPath .chezmoi.homeDir ".pi" "agent" "models.json")) -}}
{{-   $exclude = concat $exclude (list
        "local-coder/**"
        "local-reason/**"
        "local-assistant/**"
        "local-reason-long/**"
        "local-quality/**"
      )
-}}
{{- end -}}
{{- $enabledModels := list -}}
{{- range $allModels -}}
{{-   if not (has . $exclude) -}}
{{-     $enabledModels = append $enabledModels . -}}
{{-   end -}}
{{- end -}}
  "enabledModels": {{ $enabledModels | toJson }},
  "contextPrune": {
    "enabled": true,
    "quietOversizedSkips": true,
    "showPruneStatusLine": false,
    "summarizerModel": "alias/light"
  },
  "skills": ["~/.agents/skills"],
  "terminal": {
    "showTerminalProgress": true
  },
  "enableInstallTelemetry": false,
  "collapseChangelog": true
}
