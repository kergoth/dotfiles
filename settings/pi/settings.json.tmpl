{
  "theme": "catppuccin-latte/dracula",
  "packages": [
{{- /* extensions/model-alias/index.ts resolves @anthropic-ai/claude-agent-sdk from agent/npm;
       the Git-installed bridge's dependency tree is not visible there. */}}
{{- $entries := list -}}
{{- range .pi_packages -}}
{{-   $when := dig "when" "" . -}}
{{-   if or (not $when) (and (eq $when "work") $.work) -}}
{{-     $exclude := dig "skills_exclude" (list) . -}}
{{-     if $exclude -}}
{{-       $skills := list -}}
{{-       range $exclude -}}
{{-         $skills = append $skills (printf "-%s" .) -}}
{{-       end -}}
{{-       $entries = append $entries (dict "skills" $skills "source" .source | toJson) -}}
{{-     else -}}
{{-       $entries = append $entries (.source | toJson) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $entries = append $entries (printf "git:github.com/kergoth/pi-claude-bridge@%s" (index .git_lock "pi_claude_bridge") | toJson) -}}
    {{ $entries | join ",\n    " }}
  ],
  "selfUpdateCommand": [
    "python3",
    {{ joinPath .chezmoi.workingTree "scripts/pi-managed-install.py" | toJson }},
    "--refuse-self-update"
  ],
  "hideThinkingBlock": true,
  "quietStartup": true,
  "showHardwareCursor": true,
  "defaultThinkingLevel": "medium",
  "defaultTools": ["+codemode"],
  "tuiMode": "fullscreen",
  "steeringMode": "all",
  "followUpMode": "all",
{{- $allModels := list
    "alias/coding-budget"
    "alias/coding"
    "alias/coding-max"
    "alias/research"
    "alias/chat"
    "alias/light"
    "claude-bridge/claude-sonnet-5-5"
    "openai-codex/gpt-6.1-sol"
    "opencode-go/deepseek-v4.1-flash"
    "opencode-go/kimi-k2.7-code"
    "cursor/grok-4.7@256k"
    "claude-bridge/claude-opus-5-5"
    "opencode-go/glm-5.3"
    "opencode-go/deepseek-v4-pro"
    "cursor/composer-2-5"
    "cursor/auto-smart"
    "local-coder/**"
    "local-reason/**"
    "mtplx/**"
    "claude-bridge/claude-sonnet-4-6"
    "claude-bridge/claude-opus-4-6"
    "claude-bridge/claude-sonnet-5"
    "claude-bridge/claude-opus-5"
    "openai-codex/gpt-6-astra"
    "local-assistant/**"
    "openai-codex/gpt-6-luna"
    "opencode-go/gpt-6-luna"
    "opencode-go/qwen3.8-flash"
    "local-reason-long/**"
    "local-quality/**"
    "claude-bridge/claude-sonnet-*"
    "claude-bridge/claude-opus-*"
    "openai-codex/gpt-5.6-*"
-}}
{{- $exclude := list -}}
{{- if not .personal -}}
{{-   $exclude = concat $exclude (list
        "mtplx/**"
      )
-}}
{{- end -}}
{{- if .work -}}
{{-   $exclude = concat $exclude (list
        "opencode-go/glm-5.3"
        "opencode-go/deepseek-v4-pro"
        "opencode-go/kimi-k2.7-code"
        "opencode-go/deepseek-v4.1-flash"
        "opencode-go/gpt-6-luna"
        "opencode-go/qwen3.8-flash"
      )
-}}
{{- end -}}
{{- if not .work -}}
{{-   $exclude = concat $exclude (list
        "cursor/composer-2-5"
        "cursor/auto-smart"
        "cursor/grok-4.7@256k"
      )
-}}
{{- end -}}
{{- if not (stat (joinPath .chezmoi.homeDir ".pi" "agent" "models.json")) -}}
{{-   $exclude = concat $exclude (list
        "local-coder/**"
        "local-reason/**"
        "local-assistant/**"
        "local-reason-long/**"
        "local-quality/**"
      )
-}}
{{- end -}}
{{- $enabledModels := list -}}
{{- range $allModels -}}
{{-   if not (has . $exclude) -}}
{{-     $enabledModels = append $enabledModels . -}}
{{-   end -}}
{{- end -}}
  "enabledModels": {{ $enabledModels | toJson }},
  "contextPrune": {
    "enabled": true,
    "quietOversizedSkips": true,
    "showPruneStatusLine": false,
    "summarizerModel": "alias/light"
  },
  "skills": ["~/.agents/skills"],
  "terminal": {
    "showTerminalProgress": true
  },
  "enableInstallTelemetry": false,
  "collapseChangelog": true
}
