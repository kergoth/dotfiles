{
  "theme": "light/dracula",
  "packages": [
    "npm:@sherif-fanous/pi-dracula",
    "npm:pi-json-tools",
    "npm:pi-claude-bridge",
    "npm:@cmcconomy/pi-qwen-tool-parser",
    "npm:pi-web-access",
    {
      "skills": [
        "-skills/mcp-scripting/SKILL.md"
      ],
      "source": "npm:pi-mcp-adapter"
    },
    {
      "skills": [
        "-skills/council-mode/SKILL.md"
      ],
      "source": "npm:pi-subagents"
    },
    "npm:@nicknisi/pi-session-name@0.1.10",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents"
  ],
  "hideThinkingBlock": true,
  "quietStartup": true,
  "showHardwareCursor": true,
  "defaultThinkingLevel": "medium",
  "tuiMode": "fullscreen",
  "steeringMode": "all",
  "followUpMode": "all",
  "enabledModels": [
    "openai-codex/gpt-5.6-terra",
    "claude-bridge/claude-sonnet-4-6",
    "claude-bridge/claude-opus-4-6",
    "local-coder/**",
    "local-reason/**",
    "mtplx/**",
    "claude-bridge/claude-sonnet-5",
    "claude-bridge/claude-opus-5",
    "openai-codex/gpt-5.6-sol",
    "local-assistant/**",
    "openai-codex/gpt-5.6-luna",
    "local-reason-long/**",
    "local-quality/**",
    "claude-bridge/claude-sonnet-*",
    "claude-bridge/claude-opus-*",
    "openai-codex/**"
  ],
  "skills": ["~/.agents/skills"],
  "terminal": {
    "showTerminalProgress": true
  },
  "enableInstallTelemetry": false,
  "collapseChangelog": true
}
