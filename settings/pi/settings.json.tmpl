{
  "defaultModel": "gpt-5.6-terra",
  "defaultProvider": "openai-codex",
  "theme": "light/dracula",
  "packages": [
    "npm:@sherif-fanous/pi-dracula",
    "npm:pi-json-tools",
    "npm:pi-claude-bridge",
    "npm:@cmcconomy/pi-qwen-tool-parser",
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents"
  ],
  "hideThinkingBlock": true,
  "showHardwareCursor": true,
  "defaultThinkingLevel": "medium",
  "tuiMode": "fullscreen",
  "steeringMode": "all",
  "followUpMode": "all",
  "enabledModels": ["claude-bridge/*", "openai-codex/*", "local-*/**", "mtplx/*"],
  "skills": ["~/.agents/skills"]
}
