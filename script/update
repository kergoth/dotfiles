#!/usr/bin/env bash

set -euo pipefail

dry_run=0
no_review=0
while [ $# -gt 0 ]; do
    case "$1" in
        -n|--dry-run)
            dry_run=1
            shift
            ;;
        --no-review)
            no_review=1
            shift
            ;;
        -h|--help)
            echo "Usage: script/update [-n|--dry-run] [--no-review]"
            exit 0
            ;;
        *)
            echo >&2 "Usage: script/update [-n|--dry-run] [--no-review]"
            exit 1
            ;;
    esac
done

scriptdir=$(cd "$(dirname "$0")" && pwd -P)
sourcedir=$(dirname "$scriptdir")
PATH="$PATH:$scriptdir:$sourcedir/scripts"

# Detect VCS type
use_jj=0
if [ -d "$sourcedir/.jj" ] && command -v jj >/dev/null 2>&1; then
    use_jj=1
fi

if [ "$dry_run" -eq 1 ]; then
    echo >&2 "Dry run: checking chezmoi upgrade"
    chezmoi upgrade --dry-run || :
else
    echo >&2 "Updating chezmoi"
    chezmoi upgrade || :
fi

if [ "$dry_run" -eq 1 ]; then
    echo >&2 "Dry run: checking dotfiles repository"
    if [ "$use_jj" -eq 1 ]; then
        (cd "$sourcedir" && jj git fetch)
        echo >&2 "Dry run: fetched jj-backed dotfiles repository, not applying"
    else
        if (cd "$sourcedir" && git symbolic-ref -q HEAD >/dev/null); then
            (cd "$sourcedir" && git fetch)
            if upstream=$(cd "$sourcedir" && git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
                incoming=$(cd "$sourcedir" && git rev-list --count "HEAD..$upstream")
                if [ "$incoming" -gt 0 ]; then
                    echo >&2 "Dry run: $incoming incoming dotfiles commit(s) from $upstream"
                else
                    echo >&2 "Dry run: dotfiles repository has no upstream updates"
                fi
            else
                echo >&2 "Dry run: dotfiles branch has no upstream, fetched only"
            fi
        else
            (cd "$sourcedir" && git fetch)
            echo >&2 "Dry run: detached dotfiles repository, fetched only"
        fi
    fi
else
    echo >&2 "Updating dotfiles repository"
    if [ "$use_jj" -eq 1 ]; then
        (cd "$sourcedir" && jj git fetch)
        # Don't use chezmoi update (it would try to use git), just apply
        chezmoi apply -R
    else
        # Check if we're on a branch before attempting update
        if (cd "$sourcedir" && git symbolic-ref -q HEAD >/dev/null); then
            chezmoi update -R
        else
            echo >&2 "Warning: Not on a branch, skipping git pull. Fetching only."
            (cd "$sourcedir" && git fetch)
            chezmoi apply -R
        fi
    fi
fi

update_op_cli_versions() {
    if ! command -v python3 >/dev/null 2>&1; then
        echo >&2 "Warning: python3 not available; skipping op CLI version update"
        return 0
    fi

    python3 "$sourcedir/scripts/update-op-cli-versions.py" "$@"
}

update_container_base_image_digests() {
    if ! command -v python3 >/dev/null 2>&1; then
        echo >&2 "Warning: python3 not available; skipping container pin update"
        return 0
    fi

    python3 "$sourcedir/scripts/update-container-pins.py" "$@"
}

if [ "$dry_run" -eq 1 ]; then
    op_exit=0
    op_changes=$(update_op_cli_versions --dry-run) || op_exit=$?
    if [ "$op_exit" -ne 0 ]; then
        echo >&2 "Warning: op CLI version dry-run failed (exit $op_exit); skipping"
    elif [ -n "$op_changes" ]; then
        echo >&2 "Dry run: op CLI version changes available"
        echo "$op_changes" | sed 's/^/  /' >&2
    else
        echo >&2 "Dry run: no op CLI version changes"
    fi
else
    op_exit=0
    op_changes=$(update_op_cli_versions) || op_exit=$?
    if [ "$op_exit" -ne 0 ]; then
        echo >&2 "Warning: op CLI version update failed (exit $op_exit); skipping"
    elif [ -n "$op_changes" ]; then
        echo >&2 "Updated op CLI versions and checksums"
        {
            echo "Update op CLI versions"
            echo
            echo "$op_changes" | sed 's/^/  /'
        } >"$sourcedir/.git/COMMIT_EDITMSG"
        echo >&2 "Committing op CLI version update"
        if [ "$use_jj" -eq 1 ]; then
            commit_msg=$(cat "$sourcedir/.git/COMMIT_EDITMSG")
            (cd "$sourcedir" && jj commit -m "$commit_msg" \
                home/.chezmoidata/versions.yml)
        else
            (cd "$sourcedir" && git commit --no-verify -F .git/COMMIT_EDITMSG \
                home/.chezmoidata/versions.yml)
        fi
    fi
fi

if [ "$dry_run" -eq 1 ]; then
    container_exit=0
    container_changes=$(update_container_base_image_digests --dry-run) || container_exit=$?
    if [ "$container_exit" -ne 0 ]; then
        echo >&2 "Warning: container pin dry-run had errors (exit $container_exit); continuing"
        if [ -n "$container_changes" ]; then
            echo >&2 "Dry run: container pin partial changes available"
            echo "$container_changes" | sed 's/^/  /' >&2
        fi
    elif [ -n "$container_changes" ]; then
        echo >&2 "Dry run: container pin changes available"
        echo "$container_changes" | sed 's/^/  /' >&2
    else
        echo >&2 "Dry run: no container pin changes"
    fi
else
    container_exit=0
    container_changes=$(update_container_base_image_digests) || container_exit=$?
    if [ "$container_exit" -ne 0 ]; then
        echo >&2 "Warning: container pin update had errors (exit $container_exit); continuing"
        if [ -n "$container_changes" ]; then
            echo >&2 "Container pin partial changes:"
            echo "$container_changes" | sed 's/^/  /' >&2
        fi
    elif [ -n "$container_changes" ]; then
        echo >&2 "Updated container pins"
        {
            echo "Update container pins"
            echo
            echo "$container_changes" | sed 's/^/  /'
        } >"$sourcedir/.git/COMMIT_EDITMSG"
        echo >&2 "Committing container pin update"
        if [ "$use_jj" -eq 1 ]; then
            commit_msg=$(cat "$sourcedir/.git/COMMIT_EDITMSG")
            (cd "$sourcedir" && jj commit -m "$commit_msg" \
                home/.chezmoidata/container-lock.yml \
                test/containers)
        else
            (cd "$sourcedir" && git commit --no-verify -F .git/COMMIT_EDITMSG \
                home/.chezmoidata/container-lock.yml \
                test/containers)
        fi
    fi
fi

if [ -f "$sourcedir/scripts/update-review.py" ] && command -v uv >/dev/null 2>&1; then
    result_file=$(mktemp "${TMPDIR:-/tmp}/update-review.XXXXXX")
    trap 'rm -f "$result_file"' EXIT INT TERM
    review_args=(git --result-file "$result_file")
    [ "$dry_run" -eq 1 ] && review_args+=(--dry-run)
    [ "$no_review" -eq 1 ] && review_args+=(--no-review)
    uv run --script "$sourcedir/scripts/update-review.py" "${review_args[@]}"
    outcome=$(jq -r '.outcome' "$result_file")
    case "$outcome" in
        cancel) exit 0 ;;
        dry-run) ;;
        complete|finish)
            chezmoi apply -R || :
            if ! (cd "$sourcedir" && git diff --quiet -- home/.chezmoidata/git-lock.yml); then
                {
                    echo 'Update Git lock'
                    echo
                    echo 'Git lock updates:'
                    jq -r '.providers.git[] | "  \(.id): \(.old_sha) → \(.new_sha)"' "$result_file"
                } > "$sourcedir/.git/COMMIT_EDITMSG"
                if [ "$use_jj" -eq 1 ]; then
                    commit_msg=$(cat "$sourcedir/.git/COMMIT_EDITMSG")
                    (cd "$sourcedir" && jj commit -m "$commit_msg" home/.chezmoidata/git-lock.yml)
                else
                    (cd "$sourcedir" && git commit --no-verify -F .git/COMMIT_EDITMSG home/.chezmoidata/git-lock.yml)
                fi
            fi
            [ "$outcome" = finish ] && exit 0 ;;
    esac
fi

if [ "$dry_run" -eq 1 ]; then
    "$scriptdir/home-manager-switch" --dry-run --update-inputs "nixpkgs nixpkgs-unstable" "Update Home Manager packages"
else
    "$scriptdir/home-manager-switch" --update-inputs "nixpkgs nixpkgs-unstable" "Update Home Manager packages"
fi
