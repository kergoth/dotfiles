{{- $servers := dict -}}

{{- if not .ephemeral -}}
{{-   $_ := set $servers "deepwiki" (dict
        "type" "http"
        "url" "https://mcp.deepwiki.com/mcp") -}}
{{-   $_ := set $servers "context7" (dict
        "type" "stdio"
        "command" "npx"
        "args" (list "-y" "@upstash/context7-mcp")) -}}
{{-   $_ := set $servers "duckduckgo" (dict
        "type" "stdio"
        "command" "uvx"
        "args" (list "duckduckgo-mcp-server")) -}}
{{-   $_ := set $servers "playwright" (dict
        "type" "stdio"
        "command" "npx"
        "args" (list
          "-y" "@playwright/mcp@latest"
          "--browser" "firefox")) -}}

{{-   if and .work .secrets -}}
{{-     range $k, $v := (joinPath .chezmoi.workingTree "settings/agents/work-mcp-cursor.json.age"
          | include | decrypt | fromJson) -}}
{{-       $_ := set $servers $k $v -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{- if $servers -}}
{{- dict "mcpServers" $servers | toPrettyJson -}}
{{- end -}}
