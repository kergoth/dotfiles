{{- /* chezmoi:modify-template */ -}}
{{- /* Preserve live-only settings while keeping managed values authoritative. */ -}}
{{- /* Merge list settings that are extended locally by Claude Code. */ -}}
{{- $persist := list -}}
{{- $mergePaths := list
      "permissions.allow"
      "permissions.deny"
      "sandbox.excludedCommands"
      "sandbox.filesystem.allowWrite"
      "sandbox.filesystem.denyWrite"
      "sandbox.filesystem.allowRead"
      "sandbox.filesystem.denyRead"
      "sandbox.network.allowedDomains" -}}

{{- $managedRaw := includeTemplate (joinPath .chezmoi.workingTree "settings/claude/settings.json.tmpl") . -}}
{{- $managed := $managedRaw | fromJson -}}
{{- if eq .chezmoi.stdin "" -}}
{{-   $managedRaw -}}
{{- else -}}
{{-   $existing := fromJson .chezmoi.stdin -}}
{{-   $snapshot := $existing | toJson | fromJson -}}

{{-   $managedMerged := includeTemplate "concatValuesAtPath" (dict
        "dest"       ($managed | toJson | fromJson)
        "src"        $snapshot
        "paths"      $mergePaths
        "omit_empty" true
        ) | fromJson -}}

{{-   $merged := includeTemplate "mergeWithPersistedPaths" (dict
        "existing" $existing
        "managed"  $managedMerged
        "persist"  $persist
        ) | fromJson -}}
{{-   $merged | toPrettyJson -}}
{{- end -}}
