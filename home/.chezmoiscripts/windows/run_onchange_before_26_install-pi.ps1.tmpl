{{- if .user_setup -}}
# Stages the pinned Pi release; renders again only when the pin or artifact
# checksums change.

$ErrorActionPreference = "Stop"

# A first apply can run before setup-system provisions python3.
if (-not (Get-Command python3 -ErrorAction SilentlyContinue)) {
    Write-Warning "skipping pinned Pi install, python3 is not installed"
    exit 0
}

if (-not (Get-Command npm -ErrorAction SilentlyContinue)) {
    Write-Warning "skipping pinned Pi install, npm is not installed"
    exit 0
}

& python3 (Join-Path $env:CHEZMOI_WORKING_TREE "scripts/pi-managed-install.py") `
    --version "{{ index .git_lock "pi" | trimPrefix "v" }}" `
    --sha256-package-json "{{ index .fetch_lock "pi_package_json" }}" `
    --sha256-package-lock "{{ index .fetch_lock "pi_package_lock" }}"
if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
{{- end -}}
