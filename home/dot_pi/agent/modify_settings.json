{{- /* chezmoi:modify-template */ -}}
{{- /* Preserve live-only settings while keeping managed values authoritative. */ -}}
{{- /* Merge package lists because `pi install` appends to packages live. */ -}}
{{- $persist := list -}}
{{- $mergePaths := list
      "packages" -}}
{{- $removePaths := list
      "statusLine" -}}
{{- $removedPackages := list
      "git:github.com/kergoth/pi-statusline@f1805048422a046393b1ef1a4cc3aad2e9af097c" -}}

{{- $managedRaw := includeTemplate (joinPath .chezmoi.workingTree "settings/pi/settings.json.tmpl") . -}}
{{- $managed := $managedRaw | fromJson -}}
{{- if eq .chezmoi.stdin "" -}}
{{-   $managedRaw -}}
{{- else -}}
{{-   $existing := fromJson .chezmoi.stdin -}}
{{-   $snapshot := $existing | toJson | fromJson -}}

{{-   $managedMerged := includeTemplate "concatValuesAtPath" (dict
        "dest"       ($managed | toJson | fromJson)
        "src"        $snapshot
        "paths"      $mergePaths
        "omit_empty" true
        ) | fromJson -}}

{{-   $merged := includeTemplate "mergeWithPersistedPaths" (dict
        "existing" $existing
        "managed"  $managedMerged
        "persist"  $persist
        ) | fromJson -}}

{{-   $mergedPackages := dig "packages" (list) $merged -}}
{{-   range $removedPackages -}}
{{-     $mergedPackages = without $mergedPackages . -}}
{{-   end -}}
{{-   if $mergedPackages -}}
{{-     $_ := set $merged "packages" $mergedPackages -}}
{{-   end -}}
{{-   range $removePaths -}}
{{-     $merged = $merged | deleteValueAtPath . -}}
{{-   end -}}
{{-   $merged | toPrettyJson -}}
{{- end -}}
