{
  "$comment": "Rendered by chezmoi; consumed by the local model-alias extension. Reload with /reload after changes. Chain rationale: docs/pi-model-tiering.md.",
  "$settings": {
    "confirmSwitchAboveTokens": 131072,
    "confirmTimeoutMs": 60000,
    "unattendedSwitch": "compact",
    "compactionAlias": "light",
    "switchAboveUsedPercent": 95,
    "opencodeUsagePollMs": 300000
  },
  "$defaults": {
    "timeouts": {
      "firstEventMs": 60000,
      "stallMs": 90000
    },
    "cooldown": {
      "baseMs": 300000,
      "capMs": 3600000,
      "resetSuccesses": 3
    }
  },
{{- $hasLocal := stat (joinPath .chezmoi.homeDir ".pi" "agent" "models.json") }}
{{- $localAssistant := "local-assistant/mlx-community/gemma-4-26B-A4B-it-qat-4bit" }}
{{- if .work }}
  "coding": [
    "claude-bridge/claude-sonnet-5-5",
    "openai-codex/gpt-5.6-terra",
    "cursor/auto-smart"
  ],
  "coding-max": [
    "claude-bridge/claude-opus-5-5",
    "openai-codex/gpt-5.6-sol",
    "cursor/grok-4.7@256k"
  ],
{{-   $chat := list "openai-codex/gpt-5.6-luna" "cursor/grok-4.7@256k" "claude-bridge/claude-haiku-4-5" }}
{{-   if $hasLocal }}
{{-     $chat = concat $chat (list $localAssistant) }}
{{-   end }}
  "chat": {{ $chat | toJson }},
  "research": [
    "claude-bridge/claude-opus-5-5",
    "openai-codex/gpt-5.6-terra",
    "cursor/grok-4.7@256k"
  ],
  "light": [
    "openai-codex/gpt-5.6-luna",
    "cursor/composer-2.5",
    "claude-bridge/claude-haiku-4-5"
  ]
{{- else }}
  "coding": [
    "claude-bridge/claude-sonnet-5-5",
    "openai-codex/gpt-5.6-terra",
    "opencode-go/kimi-k2.7-code",
    "opencode-go/deepseek-v4.1-flash"
  ],
  "coding-budget": [
    "opencode-go/kimi-k2.7-code",
    "opencode-go/deepseek-v4.1-flash",
    "claude-bridge/claude-sonnet-5-5",
    "openai-codex/gpt-5.6-terra"
  ],
  "coding-max": [
    "claude-bridge/claude-opus-5-5",
    "openai-codex/gpt-5.6-sol",
    "opencode-go/deepseek-v4-pro",
    "opencode-go/kimi-k3"
  ],
{{-   $chat := list "opencode-go/glm-5.3-flash" "openai-codex/gpt-5.6-luna" "claude-bridge/claude-haiku-4-5" }}
{{-   if $hasLocal }}
{{-     $chat = concat $chat (list $localAssistant) }}
{{-   end }}
  "chat": {{ $chat | toJson }},
  "research": [
    "claude-bridge/claude-opus-5-5",
    "openai-codex/gpt-5.6-terra",
    "opencode-go/deepseek-v4-pro",
    "opencode-go/kimi-k3"
  ],
  "light": [
    "opencode-go/mimo-v2.5",
    "openai-codex/gpt-5.6-luna",
    "claude-bridge/claude-haiku-4-5"
  ]
{{- end }}
}
