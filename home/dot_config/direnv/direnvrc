layout_uv() {
    if [[ -d ".venv" ]]; then
        VIRTUAL_ENV="$(pwd)/.venv"
    fi

    if [[ -z $VIRTUAL_ENV || ! -d $VIRTUAL_ENV ]]; then
        if [[ ! -f "pyproject.toml" ]]; then
            log_status "No uv project exists. Executing \`uv init\` to create one."
            uv init --no-readme
            rm main.py
            uv venv
        else
            uv sync
        fi
        VIRTUAL_ENV="$(pwd)/.venv"
    fi
    export UV_PROJECT_ENVIRONMENT=$VIRTUAL_ENV

    if [ -d ".venv/bin" ]; then
        PATH_add .venv/bin
    elif [ -d ".venv/Scripts" ]; then
        PATH_add .venv/Scripts
    fi
    export UV_ACTIVE=1 # or VENV_ACTIVE=1
    export VIRTUAL_ENV
}

# Like source_env_if_exists, but refuse to load another .envrc unless it is
# itself allowed. The stdlib source_env bypasses direnv's approval check. A
# missing file is watched, so creating it reloads and triggers the check.
source_env_if_allowed() {
    local envrc=$1 dir report
    if [[ -d $envrc ]]; then
        envrc=$envrc/.envrc
    fi
    watch_file "$envrc"
    if [[ ! -e $envrc ]]; then
        return 0
    fi
    dir=$(cd "$(dirname "$envrc")" && pwd -P)
    envrc=$dir/$(basename "$envrc")
    # direnv status reports the .envrc found by searching up from the
    # directory, which is only the requested file if that is its name.
    report=$(cd "$dir" && "$direnv" status)
    if ! grep -qxF "Found RC path $envrc" <<<"$report"; then
        log_error "source_env_if_allowed: can only check .envrc files: $(user_rel_path "$envrc")"
        exit 1
    fi
    if ! grep -qx 'Found RC allowed 0' <<<"$report"; then
        log_error "$(user_rel_path "$envrc") is not allowed; run 'direnv allow $(user_rel_path "$dir")'"
        exit 1
    fi
    source_env "$envrc"
}

# Like source_up_if_exists, but with source_env_if_allowed's approval check.
source_up_if_allowed() {
    local envrc
    envrc=$(cd .. && find_up "${1:-.envrc}") || return 0
    source_env_if_allowed "$envrc"
}

# Like require_allowed, but tolerate missing files: watch them instead, so
# creating one later triggers a reload that then requires approval. All
# present files go to a single require_allowed call because a failed check
# stops evaluation, and `direnv allow` approves only the files it reported.
require_allowed_if_exists() {
    local file
    local -a present=()
    for file; do
        if [[ -e $file ]]; then
            present+=("$file")
        else
            watch_file "$file"
        fi
    done
    if [[ ${#present[@]} -eq 0 ]]; then
        return 0
    elif direnv_version 2.38.0 2>/dev/null; then
        require_allowed "${present[@]}"
    else
        watch_file "${present[@]}"
    fi
}
