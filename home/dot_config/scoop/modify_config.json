{{- /* chezmoi:modify-template */ -}}
{{- /* Preserve live-only settings while keeping managed values authoritative. */ -}}
{{- $persist := list -}}
{{- $managed := dict
      "aria2-warning-enabled" false
      "cat_style" "grid" -}}

{{- if eq .chezmoi.stdin "" -}}
{{-   $managed | toPrettyJson -}}
{{- else -}}
{{-   $existing := fromJson .chezmoi.stdin -}}
{{-   $merged := includeTemplate "mergeWithPersistedPaths" (dict
        "existing" $existing
        "managed"  $managed
        "persist"  $persist
        ) | fromJson -}}
{{-   $merged | toPrettyJson -}}
{{- end -}}
