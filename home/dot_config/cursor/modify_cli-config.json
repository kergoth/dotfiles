{{- /* chezmoi:modify-template */ -}}
{{- /* Preserve live-only settings while keeping managed values authoritative. */ -}}
{{- $persist := list -}}

{{- $managedRaw := joinPath .chezmoi.workingTree "settings/cursor/cli-config.json" | include -}}
{{- $managed := $managedRaw | fromJson -}}
{{- if eq .chezmoi.stdin "" -}}
{{-   $managedRaw -}}
{{- else -}}
{{-   $existing := fromJson .chezmoi.stdin -}}
{{-   $merged := includeTemplate "mergeWithPersistedPaths" (dict
        "existing" $existing
        "managed"  $managed
        "persist"  $persist
        ) | fromJson -}}
{{-   $merged | toPrettyJson -}}
{{- end -}}
